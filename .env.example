# LankaMedi AI Environment Configuration

# Primary / Default LLM: NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Secondary Fallback LLM: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Tertiary Fallback LLM: OpenAI / Groq / Ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OCR Provider: OCR.space
OCR_SPACE_API_KEY=

# Server & Security Configuration
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=change-this-in-production-lankamedi-ai
MAX_CONTENT_LENGTH_MB=16
